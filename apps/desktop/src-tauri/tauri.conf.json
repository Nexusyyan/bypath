{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bypath",
  "version": "0.3.0",
  "identifier": "dev.bypath.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Bypath",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 580,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "center": true,
        "backgroundColor": "#F9F9FA"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
